# ---------------------------------------------------------------------------
# Environment variables for the Graph Convolutional Attention release.
#
# Copy this file to `.env` and edit as needed:
#     cp .env.example .env
#
# For a purely local run you need NOTHING here — the default WANDB_MODE=offline
# lets every experiment run without a Weights & Biases account. Fill the W&B
# block only if you want run logging; fill the cloud block only to reproduce
# on Modal.
#
# The variables load automatically via `mise` ([env] _.file = ".env") and via
# direnv (the shipped .envrc). If you use neither, run
#     set -a; source .env; set +a
# before launching an experiment.
# ---------------------------------------------------------------------------

# --- Weights & Biases (logging) --------------------------------------------
# Leave as "offline" to disable logging entirely. Set to "online" once the key
# below is filled to stream metrics to W&B.
WANDB_MODE=offline

# Your W&B API key. Get one at https://wandb.ai/authorize
# WANDB_API_KEY=

# W&B destination. Entity is your username or team; project is any name.
# WANDB_ENTITY=your-wandb-entity
# WANDB_PROJECT=graph-convolutional-attention

# --- Cloud / Modal reproduction (OPTIONAL) ---------------------------------
# Only needed to reproduce experiments on Modal with the run-*.zsh wrappers.
# Leave commented for local runs.
#
# Modal orchestration names (choose any values):
# MODAL_APP_NAME=graph-denoising
# MODAL_VOLUME_NAME=graph-denoising-vol
#
# S3 / Tigris backend for checkpoint + metrics persistence:
# TMGG_TIGRIS_BUCKET=
# TMGG_TIGRIS_ACCESS_KEY=
# TMGG_TIGRIS_SECRET_KEY=
#
# Only if the package lives in a non-standard layout for Modal path discovery:
# TMGG_PATH=

# --- Advanced / debugging toggles (rarely needed) --------------------------
# FAIL_STRICTLY=1        # make the noise process raise instead of warn
# MODAL_DEBUG=1          # verbose Modal orchestration logging
# TMGG_LIGHTNING=1       # DiGress checkpoint-compat loader toggle
# TMGG_RAW=1             # DiGress checkpoint-compat loader toggle
