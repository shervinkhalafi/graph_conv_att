# direnv configuration — run `direnv allow` once to auto-load .env in this
# directory. See https://direnv.net. Optional: `mise` also loads .env via its
# [env] _.file setting, so you only need one of the two.

if [ -f .env ]; then
  dotenv .env
fi

# Prefer the project's uv-managed virtualenv if it exists.
if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add .venv/bin
fi
